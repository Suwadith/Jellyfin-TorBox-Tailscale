# ==============================================================================
# Jellyfin + TorBox + Tailscale Configuration Environment
# Copy this file to '.env' and fill in your credentials before running:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Tailscale Configuration
# ------------------------------------------------------------------------------
# Optional: Tailscale Pre-Authentication Key (e.g. tskey-auth-k123456789-...)
# If left blank, you can authenticate interactively by opening the login URL
# printed in the container logs ('docker compose logs -f tailscale').
TS_AUTHKEY=

# ------------------------------------------------------------------------------
# TorBox & TMDb API Credentials
# ------------------------------------------------------------------------------
# Required: Your TorBox API token (from https://torbox.app/settings)
TORBOX_API_TOKEN=your_torbox_api_token_here

# Required: Your TMDb API v3 Key (from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# ------------------------------------------------------------------------------
# TorBox Assistant Daemon Timing
# ------------------------------------------------------------------------------
# Library sync interval in seconds (Default: 300 = 5 minutes)
SYNC_INTERVAL_SECONDS=300

# Cache warmer full rotation cycle in days (Default: 10 days)
# TorBox items stay active in debrid cache as long as they are probed periodically.
WARMER_CYCLE_DAYS=10

# ------------------------------------------------------------------------------
# Tailscale Funnel & Remote Access (Optional)
# ------------------------------------------------------------------------------
# Public URL for Tailscale Funnel keepalive ping (prevents DERP relay timeouts).
# Example: https://jellyfin-server.your-tailnet.ts.net/System/Info/Public
# Leave blank if you only use private Tailscale VPN mesh.
FUNNEL_URL=

# ------------------------------------------------------------------------------
# Cloudflare Worker / Stream Proxy (Optional)
# ------------------------------------------------------------------------------
# If you use a Cloudflare Worker to proxy TorBox streams and update dynamic ISP IP:
# CF_UPDATE_URL=https://your-worker.workers.dev/update-ip?secret=your_secret
# CF_STREAM_URL=https://your-worker.workers.dev
# Leave blank to stream directly from TorBox CDN endpoints.
CF_UPDATE_URL=
CF_STREAM_URL=

# ------------------------------------------------------------------------------
# Automated Setup Wizard (Optional overrides for setup_jellyfin.py)
# ------------------------------------------------------------------------------
# JELLYFIN_ADMIN_USER=admin
# JELLYFIN_ADMIN_PASSWORD=your_secure_password_here
